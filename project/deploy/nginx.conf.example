# 替换域名、证书路径后放入 Nginx 配置目录。
# .env 的 ALLOWED_ORIGINS 同时设置为 https://hot.example.com。
server {
    listen 80;
    server_name hot.example.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name hot.example.com;
    ssl_certificate /etc/letsencrypt/live/hot.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/hot.example.com/privkey.pem;
    client_max_body_size 64k;
    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
    }
    location = /ws {
        proxy_pass http://127.0.0.1:8787/ws;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 600s;
        # 令牌在查询参数中，此地址不写访问日志。
        access_log off;
    }
}
