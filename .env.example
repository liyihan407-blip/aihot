# AIHot 配置模板：复制为项目根目录 .env 后修改。
# 你已有的 .env 不会被迁移程序覆盖。真实密码和 Key 不要提交到 Git。
# 配置值不要加引号。修改后需要重启 Java 服务。

# ===== 必填：你自己的 MySQL =====
# 先执行 project/sql/01-create-database.sql 创建数据库。
# 把 127.0.0.1:3306 换成你的 MySQL 地址和端口；aihot 是数据库名。
# Docker Compose 启动整套应用时会自动使用容器数据库地址，无需改这里。
DB_URL=jdbc:mysql://127.0.0.1:3306/aihot?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
# 换成你创建的数据库账号，例如 aihot 或本地开发使用的 root。
DB_USERNAME=aihot
# 必填：换成上面账号的真实密码。不要将示例密码用于公网部署。
DB_PASSWORD=请填写你的数据库密码
# 仅 Docker Compose 使用：MySQL 管理员密码，请填与业务密码不同的强密码。
MYSQL_ROOT_PASSWORD=请填写独立的管理员密码

# ===== 可选：AI 分析（留空 Key 也能使用真实来源检索和规则匹配） =====
# bailian = 阿里云百炼；siliconflow = 硅基流动；openrouter = OpenRouter。
AI_PROVIDER=bailian
# 新建百炼 API Key 后填在本机 .env，勿提交或发送给他人。
BAILIAN_API_KEY=
# 默认模型请确认已在你的百炼地域和业务空间开通。
BAILIAN_MODEL=qwen-plus
# 默认使用北京地域按量付费地址；可替换为同地域业务空间的 OpenAI 兼容 Base URL。
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 网页自定义 AI 地址允许的额外可信域名，多个用英文逗号分隔。
AI_ALLOWED_HOSTS=
# 填你自己的硅基流动 API Key；留空不调用该平台。
SILICONFLOW_API_KEY=
# 换成你的账号可用的模型 ID。
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3.2
# 选用 OpenRouter 时，填你自己的 Key 和模型 ID。
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v3.2
# 每次检索最多分析的文章数量，包括被过滤或分析失败的文章；不含至多1次关键词扩展调用。
MAX_ANALYSIS_PER_RUN=12
AI_TIMEOUT_SECONDS=35
SOURCE_TIMEOUT_SECONDS=12
# 抓取内容的有效期。没有发布时间时仍保留，在页面显示时间未知。
MAX_AGE_DAYS=7

# ===== 可选：运行地址、监控和访问保护 =====
PORT=8787
# 本机使用保持 127.0.0.1；局域网或 Docker 访问时改 0.0.0.0。
BIND_ADDRESS=127.0.0.1
# 对外部署请填写随机长令牌，访问网页时输入；本项目为个人工作台，不是多用户系统。
API_TOKEN=
# 公网部署换成自己的完整域名，例如 https://hot.example.com；多个值用英文逗号分隔。
ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
# true 开启定时监控；false 只允许手动检索。每个监控词可单独设置 5–1440 分钟间隔。
SCHEDULER_ENABLED=true
POLL_MS=60000
# 首次启动导入旧 data/state.json 的监控词、通知内容和热点来源；原文件保留。
LEGACY_IMPORT=true

# ===== 可选：重要热点的邮件提醒 =====
# 全部填写才启用；只给监控中 AI 判定 high/urgent 的新内容发送，不对手动搜索发邮件。
# SMTP_HOST 是邮箱 SMTP 地址，例如 smtp.qq.com。
SMTP_HOST=
# 587 通常使用 STARTTLS；465 通常使用 SSL，并设置 SMTP_SECURE=true。
SMTP_PORT=587
SMTP_SECURE=false
# 587 一般为 true；使用 465 + SSL 时改为 false。
SMTP_STARTTLS=true
# 发件邮箱、SMTP 授权码（通常不是邮箱登录密码）、收件邮箱。
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
