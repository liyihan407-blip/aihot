# AIHot local environment template
# Copy this file to .env for local development, then fill in real values.
# Never commit .env or files containing real API keys/passwords.

# Web server
PORT=8787
POLL_SECONDS=60

# AI provider: openrouter or siliconflow
AI_PROVIDER=siliconflow

# OpenRouter AI provider
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4.1-mini

# SiliconFlow AI provider
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3.2

# Optional development MCP/API tokens
# Used only when configuring local tools that need these services.
CONTEXT7_API_KEY=your_context7_api_key_here
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
