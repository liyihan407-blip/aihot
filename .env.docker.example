# Docker Desktop 本地配置模板。请运行 node project/scripts/setup-docker.cjs 生成独立配置。
# 更换 MySQL 密码后，不会自动修改已有 MySQL 数据卷中的账号密码。
MYSQL_PORT=3308
APP_PORT=8787
DB_USERNAME=root
DB_PASSWORD=请设置数据库密码

AI_PROVIDER=bailian
BAILIAN_API_KEY=
BAILIAN_MODEL=qwen-plus
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 网页自定义 AI 地址允许的额外可信域名，多个用英文逗号分隔。
AI_ALLOWED_HOSTS=
# 只在本机访问时可留空；如需设置访问令牌，请自己填写。
API_TOKEN=
# 首次运行先关闭自动监控；需要时可以设为 true。
SCHEDULER_ENABLED=false
